@model IEnumerable<MedikoData.Entities.LogBook>

@{
    ViewData["Title"] = "LogBooks";
}

<h3> <a class="btn btn-sm btn-secondary mb-1" asp-action="Options" asp-controller="User">
        <i class="bi bi-arrow-left-square"></i></a> Logbooks manager
    <a class="btn btn-sm btn-primary mb-1" asp-action="Create"><i class="bi bi-plus-circle icon"></i>Maak een nieuw
        Logboek</a>
</h3>

<table class="table table-responsive">
    <thead>
        <tr>

            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <a asp-action="Details" asp-route-id="@item.LogBookId">
                        @Html.DisplayFor(modelItem => item.Name) </a>
                </td>
                <td>
                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.LogBookId">
                        <i class="bi bi-pencil-fill icon"></i>Wijzig</a>
                </td>
            </tr>
        }
    </tbody>
</table>
